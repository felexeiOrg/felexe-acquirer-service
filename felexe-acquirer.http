@baseUrl = http://localhost:3000/v2/api
@mobile = 9876543210
@tempPassword = Admin@1234
@otp = 000000
@verificationToken = replace-after-verify-otp
@newPassword = Secure@Pass1

############################################################
# ALL APIs in this one file
# Language mode (bottom-right) must be HTTP
# Click "Send Request" or press Cmd+Option+R
############################################################

### Gateway health
GET {{baseUrl}}/

### Auth - Register (temp password = FirstName + special + 4 digits)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "company_name": "Your Company Pvt Ltd",
  "business_website": "https://example.com",
  "company_type": "private_limited",
  "first_name": "Admin",
  "last_name": "User",
  "mobile": "{{mobile}}",
  "email": "admin@example.com"
}

### Auth - Login (mobile + password) -> returns OTP
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "password": "{{tempPassword}}"
}

### Auth - Verify OTP (after login) -> returns verification_token + requires_password_update
POST {{baseUrl}}/auth/verify-otp
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "otp": "{{otp}}",
  "purpose": "login"
}

### Auth - Update password (first login / after OTP)
POST {{baseUrl}}/auth/update-password
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "verification_token": "{{verificationToken}}",
  "new_password": "{{newPassword}}"
}

### Auth - Forgot password (send OTP to mobile)
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "mobile": "{{mobile}}"
}

### Auth - Verify OTP (forgot password)
POST {{baseUrl}}/auth/verify-otp
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "otp": "{{otp}}",
  "purpose": "forgot_password"
}

### Auth - Update password (forgot password reset)
POST {{baseUrl}}/auth/update-password
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "verification_token": "{{verificationToken}}",
  "new_password": "Reset@Pass9"
}

### Merchant Onboarding
GET {{baseUrl}}/merchant-onboarding

### Merchant Governance
GET {{baseUrl}}/merchant-governace

### Dispute Management
GET {{baseUrl}}/dispute-mng

### Recon Management
GET {{baseUrl}}/recon-mng

### MIS Reports
GET {{baseUrl}}/mis-reports

### KYC API Integration
GET {{baseUrl}}/kyc-api-integration

### KYC - Verify PAN
POST {{baseUrl}}/kyc-api-integration/verifyPan
Content-Type: application/json

{
  "pan": "FBDPP3655R"
}

### KYC - Initiate Aadhaar via DigiLocker
POST {{baseUrl}}/kyc-api-integration/initiateAdharVerificationViaDigilocker
Content-Type: application/json

{
  "aadhaar": "123456789012"
}

### KYC - Get Aadhaar verification status
POST {{baseUrl}}/kyc-api-integration/getAdharVerificationStatus
Content-Type: application/json

{
  "request_id": "REQ123457",
  "verification_id": "eyJjbGllbnRJZCI6IktSN0U3WE0zSzIiLCJyZXF1ZXN0X2lkIjoiUkVRMTIzNDU3IiwiZXhwaXJ5QXQiOjE3ODU3NjU2Mzk1OTV9"
}

### KYC - Udyam verification
POST {{baseUrl}}/kyc-api-integration/udyam-verification
Content-Type: application/json

{
  "udyam_number": "UXXXM-XX-XX-0XXXX4"
}

### KYC - FSSAI validation
POST {{baseUrl}}/kyc-api-integration/fssaiValidation
Content-Type: application/json

{
  "flrs_license_no": "21xxxxxxxxx81"
}

### KYC - Shop Establishment validation
POST {{baseUrl}}/kyc-api-integration/shopEstablishmentValidation
Content-Type: application/json

{
  "registration_number": "108971072503",
  "state": "Maharashtra"
}

### KYC - Get CIN by company name
POST {{baseUrl}}/kyc-api-integration/getCINnoByCompanyName
Content-Type: application/json

{
  "company_name": "A******* Private Limited"
}

### KYC - Get company details by CIN
POST {{baseUrl}}/kyc-api-integration/getCompanyDetailsByCINno
Content-Type: application/json

{
  "company_id": "U729XXXXXXXXXXXXXX851"
}

### KYC - DIN validation
POST {{baseUrl}}/kyc-api-integration/dinValidation
Content-Type: application/json

{
  "din_number": "0******6"
}

### KYC - Verify GST
POST {{baseUrl}}/kyc-api-integration/verifyGST
Content-Type: application/json

{
  "gstNumber": "08XXXXXXXX1DW"
}

### KYC - Verify bank account
POST {{baseUrl}}/kyc-api-integration/verifyBankAccount
Content-Type: application/json

{
  "acc_number": "9XXXXXXXXXXXXX77",
  "ifsc_number": "UTIXXXXXX794"
}
