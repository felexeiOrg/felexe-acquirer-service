@baseUrl = http://localhost:3000/v2/api
@mobile = 9876543210
@tempPassword = Admin@1234
@otp = 000000
@verificationToken = replace-after-verify-otp
@newPassword = Secure@Pass1

############################################################
# ALL APIs in this one file
# Language mode (bottom-right) must be HTTP
# Click "Send Request" or press Cmd+Option+R
############################################################

### Gateway health
GET {{baseUrl}}/

### Auth - Register (temp password = FirstName + special + 4 digits)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "company_name": "Your Company Pvt Ltd",
  "business_website": "https://example.com",
  "company_type": "private_limited",
  "first_name": "Admin",
  "last_name": "User",
  "mobile": "{{mobile}}",
  "email": "admin@example.com"
}

### Merchant Onboarding - Send Invite (creates merchant login via auth/register)
POST {{baseUrl}}/merchant-onboarding/sendInvite
Content-Type: application/json

{
  "company_name": "Merchant Co Pvt Ltd",
  "business_website": "https://merchant.example.com",
  "company_type": "private_limited",
  "first_name": "Merchant",
  "last_name": "Owner",
  "mobile": "9876543211",
  "email": "merchant@example.com"
}

### Merchant Onboarding - Add Merchant Details (GST → CIN → company profile)
POST {{baseUrl}}/merchant-onboarding/addMerchantDetails
Content-Type: application/json

{
  "gstNumber": "27AAKCT9792K2ZA"
}

### Merchant Onboarding - Get Merchant by clientId
@clientId = replace-with-client-id-from-addMerchantDetails
GET {{baseUrl}}/merchant-onboarding/{{clientId}}

### Merchant Onboarding - Update Merchant (POST — all fields optional)
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/update
Content-Type: application/json

{
  "legalName": "SYNRA FINTEK PRIVATE LIMITED",
  "tradeName": "SYNRA FINTEK",
  "status": "pending",
  "verificationStatus": "in_review",
  "directors": [
    {
      "din": "12345678",
      "pan": "AAKCT9792K",
      "firstName": "John",
      "lastName": "Doe",
      "fullName": "John Doe",
      "dateOfAppointment": "2024-01-01",
      "disqualified": false,
      "isVerified": false,
      "isVkycVerified": false
    }
  ],
  "authorizedSignatories": [
    {
      "din": "87654321",
      "pan": "AAKCT9792K",
      "firstName": "Jane",
      "lastName": "Doe",
      "fullName": "Jane Doe",
      "dateOfAppointment": "2024-01-01",
      "disqualified": false,
      "isVerified": false,
      "isVkycVerified": false
    }
  ]
}

### Merchant Onboarding - Delete Merchant (POST soft-delete)
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/delete
Content-Type: application/json

{}

### Directors - List
GET {{baseUrl}}/merchant-onboarding/{{clientId}}/directors

### Directors - Create
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/directors
Content-Type: application/json

{
  "din": "12345678",
  "pan": "AAKCT9792K",
  "firstName": "John",
  "lastName": "Doe",
  "fullName": "John Doe",
  "dateOfAppointment": "2024-01-01",
  "disqualified": false,
  "isVerified": false,
  "isVkycVerified": false
}

### Directors - Get by id
@directorId = replace-with-director-id
GET {{baseUrl}}/merchant-onboarding/{{clientId}}/directors/{{directorId}}

### Directors - Update (POST)
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/directors/{{directorId}}/update
Content-Type: application/json

{
  "fullName": "John Updated Doe",
  "isVerified": true,
  "videoKycStatus": "completed"
}

### Directors - Delete (POST soft-delete)
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/directors/{{directorId}}/delete
Content-Type: application/json

{}

### Authorizers - List
GET {{baseUrl}}/merchant-onboarding/{{clientId}}/authorizers

### Authorizers - Create
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/authorizers
Content-Type: application/json

{
  "din": "87654321",
  "pan": "AAKCT9792K",
  "firstName": "Jane",
  "lastName": "Doe",
  "fullName": "Jane Doe",
  "dateOfAppointment": "2024-01-01",
  "disqualified": false,
  "isVerified": false,
  "isVkycVerified": false
}

### Authorizers - Get by id
@authorizerId = replace-with-authorizer-id
GET {{baseUrl}}/merchant-onboarding/{{clientId}}/authorizers/{{authorizerId}}

### Authorizers - Update (POST)
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/authorizers/{{authorizerId}}/update
Content-Type: application/json

{
  "fullName": "Jane Updated Doe",
  "isVerified": true
}

### Authorizers - Delete (POST soft-delete)
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/authorizers/{{authorizerId}}/delete
Content-Type: application/json

{}

### Bank Details - List
GET {{baseUrl}}/merchant-onboarding/{{clientId}}/bank-details

### Bank Details - Create
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/bank-details
Content-Type: application/json

{
  "accountNumber": "9876543210123",
  "ifscCode": "HDFC0001234",
  "bankName": "HDFC Bank",
  "branchName": "Mumbai Main",
  "accountHolderName": "SYNRA FINTEK PRIVATE LIMITED",
  "accountType": "current",
  "isPrimary": true,
  "isVerified": false,
  "verificationStatus": "pending"
}

### Bank Details - Get by id
@bankDetailId = replace-with-bank-detail-id
GET {{baseUrl}}/merchant-onboarding/{{clientId}}/bank-details/{{bankDetailId}}

### Bank Details - Update (POST)
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/bank-details/{{bankDetailId}}/update
Content-Type: application/json

{
  "isVerified": true,
  "verificationStatus": "verified",
  "accountHolderName": "SYNRA FINTEK PVT LTD"
}

### Bank Details - Delete (POST soft-delete)
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/bank-details/{{bankDetailId}}/delete
Content-Type: application/json

{}

### Auth - Login (mobile + password) -> returns OTP
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "password": "{{tempPassword}}"
}

### Auth - Verify OTP (after login) -> returns verification_token + requires_password_update
POST {{baseUrl}}/auth/verify-otp
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "otp": "{{otp}}",
  "purpose": "login"
}

### Auth - Update password (first login / after OTP)
POST {{baseUrl}}/auth/update-password
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "verification_token": "{{verificationToken}}",
  "new_password": "{{newPassword}}"
}

### Auth - Forgot password (send OTP to mobile)
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "mobile": "{{mobile}}"
}

### Auth - Verify OTP (forgot password)
POST {{baseUrl}}/auth/verify-otp
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "otp": "{{otp}}",
  "purpose": "forgot_password"
}

### Auth - Update password (forgot password reset)
POST {{baseUrl}}/auth/update-password
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "verification_token": "{{verificationToken}}",
  "new_password": "Reset@Pass9"
}

### Merchant Onboarding
GET {{baseUrl}}/merchant-onboarding

### Merchant Governance
GET {{baseUrl}}/merchant-governace

### Dispute Management
GET {{baseUrl}}/dispute-mng

### Recon Management
GET {{baseUrl}}/recon-mng

### MIS Reports
GET {{baseUrl}}/mis-reports

### KYC API Integration
GET {{baseUrl}}/kyc-api-integration

### KYC - Verify PAN
POST {{baseUrl}}/kyc-api-integration/verifyPan
Content-Type: application/json

{
  "pan": "FBDPP3655R"
}

### KYC - Initiate Aadhaar via DigiLocker
POST {{baseUrl}}/kyc-api-integration/initiateAdharVerificationViaDigilocker
Content-Type: application/json

{
  "aadhaar": "123456789012"
}

### KYC - Get Aadhaar verification status
POST {{baseUrl}}/kyc-api-integration/getAdharVerificationStatus
Content-Type: application/json

{
  "request_id": "REQ123457",
  "verification_id": "eyJjbGllbnRJZCI6IktSN0U3WE0zSzIiLCJyZXF1ZXN0X2lkIjoiUkVRMTIzNDU3IiwiZXhwaXJ5QXQiOjE3ODU3NjU2Mzk1OTV9"
}

### KYC - Udyam verification
POST {{baseUrl}}/kyc-api-integration/udyam-verification
Content-Type: application/json

{
  "udyam_number": "UXXXM-XX-XX-0XXXX4"
}

### KYC - FSSAI validation
POST {{baseUrl}}/kyc-api-integration/fssaiValidation
Content-Type: application/json

{
  "flrs_license_no": "21xxxxxxxxx81"
}

### KYC - Shop Establishment validation
POST {{baseUrl}}/kyc-api-integration/shopEstablishmentValidation
Content-Type: application/json

{
  "registration_number": "108971072503",
  "state": "Maharashtra"
}

### KYC - Get CIN by company name
POST {{baseUrl}}/kyc-api-integration/getCINnoByCompanyName
Content-Type: application/json

{
  "company_name": "A******* Private Limited"
}

### KYC - Get company details by CIN
POST {{baseUrl}}/kyc-api-integration/getCompanyDetailsByCINno
Content-Type: application/json

{
  "company_id": "U729XXXXXXXXXXXXXX851"
}

### KYC - DIN validation
POST {{baseUrl}}/kyc-api-integration/dinValidation
Content-Type: application/json

{
  "din_number": "0******6"
}

### KYC - Verify GST
POST {{baseUrl}}/kyc-api-integration/verifyGST
Content-Type: application/json

{
  "gstNumber": "08XXXXXXXX1DW"
}

### KYC - Verify bank account
POST {{baseUrl}}/kyc-api-integration/verifyBankAccount
Content-Type: application/json

{
  "acc_number": "9XXXXXXXXXXXXX77",
