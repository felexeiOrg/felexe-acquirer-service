@baseUrl = http://localhost:3000/v2/api
@mobile = 9876543210
@tempPassword = Admin@1234
@otp = 000000
@verificationToken = replace-after-verify-otp
@newPassword = Secure@Pass1

############################################################
# ALL APIs in this one file
# Language mode (bottom-right) must be HTTP
# Click "Send Request" or press Cmd+Option+R
############################################################

### Gateway health
GET {{baseUrl}}/

### Auth - Register (temp password = FirstName + special + 4 digits)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "company_name": "felexei Private Limted",
  "business_website": "https://felexei.com",
  "company_type": "private_limited",
  "first_name": "Ketan",
  "last_name": "Patange",
  "mobile": "9284329868",
  "email": "tech@felexei.com"
}

### Merchant Onboarding - Send Invite (creates merchant login via auth/register)
POST {{baseUrl}}/merchant-onboarding/sendInvite
Content-Type: application/json

{
  "company_name": "Merchant Co Pvt Ltd",
  "business_website": "https://merchant.example.com",
  "company_type": "private_limited",
  "first_name": "Merchant",
  "last_name": "Owner",
  "mobile": "9876543211",
  "email": "merchant@example.com"
}

### Merchant Onboarding - Invited merchants (admin only — requires login cookies)
GET {{baseUrl}}/merchant-onboarding/invited-merchants

### Merchant list after 6-step onboarding (verification_pending + verified)
GET {{baseUrl}}/merchant-onboarding/merchants

### Completed / verified merchants (charge configuration list)
GET {{baseUrl}}/merchant-onboarding/completed-merchants

### Charges - Load merchant payin/payout config (admin)
GET {{baseUrl}}/charges/getCharge/{{clientId}}

### Charges - Save merchant config (admin). Repeat with paymentMode payout.
POST {{baseUrl}}/charges/saveCharge/{{clientId}}
Content-Type: application/json

{
  "clientId": "{{clientId}}",
  "paymentMode": "payin",
  "modeOfCharge": "flat",
  "flat": {
    "chargePercent": "1.85",
    "chargeFlat": "5.00",
    "commissionPercent": "0.30",
    "commissionFlat": "1.50"
  },
  "slabs": [
    {
      "minAmount": "0",
      "maxAmount": "1000",
      "chargePercent": "2.00",
      "chargeFlat": "3.00",
      "commissionPercent": "0.20",
      "commissionFlat": "1.00"
    }
  ]
}

### Admin verification - Pending maker submissions
GET {{baseUrl}}/merchant-onboarding/admin/pending

### Admin verification - Full review packet
GET {{baseUrl}}/merchant-onboarding/admin/{{clientId}}

### Admin verification - Approve/reject one section
POST {{baseUrl}}/merchant-onboarding/admin/{{clientId}}/sections/merchant_details/review
Content-Type: application/json

{
  "decision": "approved",
  "remarks": "GST and CIN details match"
}

### Admin verification - Approve/reject one document
POST {{baseUrl}}/merchant-onboarding/admin/{{clientId}}/documents/{{documentId}}/review
Content-Type: application/json

{
  "decision": "approved",
  "remarks": "GST certificate is valid"
}

### Admin verification - Final approval
POST {{baseUrl}}/merchant-onboarding/admin/{{clientId}}/approval
Content-Type: application/json

{
  "decision": "approved",
  "remarks": "All sections and documents verified"
}

### Merchant Onboarding - Start onboarding (with GST or without GST)
POST {{baseUrl}}/merchant-onboarding/onboarding/start
Content-Type: application/json

{
  "userId": "replace-with-logged-in-user-id",
  "onboardingType": "with_gst"
}

### Merchant Onboarding - Get onboarding tab status (by user)
GET {{baseUrl}}/merchant-onboarding/onboarding/status?userId=replace-with-user-id

### Merchant Onboarding - Get onboarding tab status (by clientId)
GET {{baseUrl}}/merchant-onboarding/{{clientId}}/onboarding/status

### Merchant Onboarding - Merchant details form config (readonly + checkbox fields)
GET {{baseUrl}}/merchant-onboarding/{{clientId}}/merchant-details/form-config

### Merchant Onboarding - Submit merchant details tab
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/sections/merchant-details/submit
Content-Type: application/json

{
  "selections": {
    "businessActivity.natureOfBusiness": ["0"],
    "businessActivity.hsnServices": ["998313", "998319"],
    "addresses.companyAddresses": ["0", "1"]
  }
}

### Merchant Onboarding - Submit directors tab
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/sections/directors/submit

### Merchant Onboarding - Submit authorizers tab
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/sections/authorizers/submit

### Merchant Onboarding - Submit bank details tab
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/sections/bank-details/submit

### Merchant Onboarding - Submit video KYC tab
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/sections/video-kyc/submit

### Video KYC - Initiate provider session (JWT merchant cookie)
POST {{baseUrl}}/merchant-onboarding/vkyc/initiate
Content-Type: application/json

{
  "personId": "replace-with-director-or-authorizer-id",
  "type": "Director"
}

### Video KYC - List persons for logged-in merchant
GET {{baseUrl}}/merchant-onboarding/vkyc-persons

### Video KYC - Provider webhook (no JWT, HMAC x-signature)
POST {{baseUrl}}/merchant-onboarding/webhooks/vkyc
Content-Type: application/json
x-signature: replace-with-hmac-sha256-hex

{
  "session_id": "replace-with-session-id",
  "status": "confirmed",
  "video_url": "https://videokyc-api.synra.in/videos/sample.mp4",
  "face_video_url": "https://videokyc-api.synra.in/videos/face.mp4",
  "ocr_data": {
    "aadhaar_photo_url": "https://videokyc-api.synra.in/ocr/aadhaar.jpg",
    "pan_photo_url": "https://videokyc-api.synra.in/ocr/pan.jpg"
  },
  "metadata": {}
}

### Admin Video KYC - List persons for a merchant
GET {{baseUrl}}/merchant-onboarding/admin/{{clientId}}/vkyc-persons

### Admin Video KYC - Approve director
POST {{baseUrl}}/merchant-onboarding/admin/directors/{{directorId}}/approve
Content-Type: application/json

{
  "type": "VKYC"
}

### Admin Video KYC - Reject director
POST {{baseUrl}}/merchant-onboarding/admin/directors/{{directorId}}/reject
Content-Type: application/json

{
  "type": "VKYC",
  "reason": "Face does not match PAN photo"
}

### Admin Video KYC - Approve authorizer
POST {{baseUrl}}/merchant-onboarding/admin/authorizers/{{authorizerId}}/approve
Content-Type: application/json

{
  "type": "VKYC"
}

### Merchant Onboarding - Submit documents tab
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/sections/documents/submit

### Merchant Onboarding - Complete onboarding (maker submit)
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/onboarding/complete

### Merchant Onboarding - Add Merchant Details (GST → CIN → company profile)
POST {{baseUrl}}/merchant-onboarding/addMerchantDetails
Content-Type: application/json

{
  "gstNumber": "27AAKCT9792K2ZA",
  "userId": "replace-with-logged-in-merchant-user-id",
  "mobile": "9876543211"
}

### Merchant Onboarding - Get Merchant by clientId
@clientId = replace-with-client-id-from-addMerchantDetails
GET {{baseUrl}}/merchant-onboarding/{{clientId}}

