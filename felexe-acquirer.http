### Directors - Update (POST)
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/directors/{{directorId}}/update
Content-Type: application/json

{
  "fullName": "John Updated Doe",
  "isVerified": true,
  "videoKycStatus": "completed"
}

### Directors - Upload Video KYC recording (multipart: file)
# Allowed: WEBM, MP4, MOV, OGG — max 50MB
# curl -X POST "{{baseUrl}}/merchant-onboarding/YOUR_CLIENT_ID/directors/YOUR_DIRECTOR_ID/video-kyc/upload" \
#   -F "file=@/path/to/director-vkyc.webm"
POST {{baseUrl}}/merchant-onboarding/{{clientId}}/directors/{{directorId}}/video-kyc/upload
Content-Type: multipart/form-data; boundary=----FelexeVideoBoundary

------FelexeVideoBoundary
Content-Disposition: form-data; name="file"; filename="director-vkyc.webm"
Content-Type: video/webm

< ./director-vkyc.webm
------FelexeVideoBoundary--

