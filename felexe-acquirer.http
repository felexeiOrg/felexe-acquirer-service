### Auth - Login (mobile + password) -> returns OTP
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "password": "{{tempPassword}}"
}

### Auth - Verify OTP (after login)
### Sets HttpOnly cookies: verification_token (password change) OR access_token + refresh_token (login complete)
POST {{baseUrl}}/auth/verify-otp
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "otp": "{{otp}}",
  "purpose": "login"
}

### Auth - Update password (first login / after OTP)
### verification_token is read from HttpOnly cookie; body field is optional
POST {{baseUrl}}/auth/update-password
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "new_password": "{{newPassword}}"
}

### Auth - Refresh access token (uses refresh_token cookie)
POST {{baseUrl}}/auth/refresh

### Auth - Logout (clears auth cookies)
POST {{baseUrl}}/auth/logout

### Auth - Forgot password (send OTP to mobile)
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "mobile": "{{mobile}}"
}

### Auth - Verify OTP (forgot password)
POST {{baseUrl}}/auth/verify-otp
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "otp": "{{otp}}",
  "purpose": "forgot_password"
}

### Auth - Update password (forgot password reset)
POST {{baseUrl}}/auth/update-password
Content-Type: application/json

{
  "mobile": "{{mobile}}",
  "new_password": "Reset@Pass9"
}

